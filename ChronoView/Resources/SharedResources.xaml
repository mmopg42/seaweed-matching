                                 Visibility="{Binding NirGraphThumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <CheckBox Style="{StaticResource PartialSelectionCheckBoxStyle}" IsChecked="{Binding IsNirSelected}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding NirLabel}"
                       HorizontalAlignment="Center"
                       FontSize="{Binding DataContext.DisplayFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="Black"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </DataTemplate>


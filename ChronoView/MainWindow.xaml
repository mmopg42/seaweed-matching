<Window x:Class="ChronoView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChronoView"
        xmlns:vm="clr-namespace:ChronoView.UI.ViewModels"
        xmlns:controls="clr-namespace:ChronoView.UI.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:ChronoView.UI.Behaviors"
        xmlns:res="clr-namespace:ChronoView.Resources"
        xmlns:views="clr-namespace:ChronoView.UI.Views"
        mc:Ignorable="d"
        Title="ChronoView Pro - Desktop Application" 
        Height="900" Width="1400"
        Background="#f0f0f0"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <DockPanel>
        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}">
            <ToolBar Background="{StaticResource PanelBackgroundBrush}" 
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StartCommand}" ToolTip="{x:Static res:Strings.Tooltip_StartMonitoring}"
                        AutomationProperties.AutomationId="ToolbarStartButton">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/Images/start_icon.png"
                               Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="시작" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StopCommand}" ToolTip="{x:Static res:Strings.Tooltip_StopMonitoring}"
                        AutomationProperties.AutomationId="ToolbarStopButton">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/Images/stop_icon.png"
                               Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="중지" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Setup_Click" ToolTip="{x:Static res:Strings.Tooltip_OpenSettings}"
                        AutomationProperties.AutomationId="ToolbarSettingsButton">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/Images/settings_icon.png" 
                               Width="16" Height="16" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="설정" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="{x:Static res:Strings.Tooltip_RefreshData}"
                        AutomationProperties.AutomationId="ToolbarRefreshButton">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/Images/refresh_icon.png"
                               Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="새로고침" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MoveCommand}" ToolTip="{x:Static res:Strings.Tooltip_MoveSelected}"
                        AutomationProperties.AutomationId="ToolbarMoveButton">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/Images/next_icon.png"
                               Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="이동" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="{x:Static res:Strings.Tooltip_DeleteSelected}"
                        AutomationProperties.AutomationId="ToolbarDeleteButton">
                    <StackPanel>
                        <TextBlock Text="🗑" FontSize="16"/>
                        <TextBlock Text="삭제" FontSize="10"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>
        
        <!-- File Count and Matching Statistics -->
        <controls:StatisticsPanel DockPanel.Dock="Top" DataContext="{Binding Dashboard}"/>
        
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBackgroundBrush}" 
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>

            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="총 그룹: "/>
                    <TextBlock Text="{Binding Dashboard.TotalGroups}" FontWeight="Bold" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Failures: "/>
                    <TextBlock Text="{Binding Dashboard.FailedCount}" FontWeight="Bold" Foreground="Red" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>
            <StatusBarItem HorizontalAlignment="Right" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Width="200">
                    <ProgressBar Width="150" Height="16"
                                 Value="{Binding Operations.ProgressValue}"
                                 Minimum="0" Maximum="100"
                                 Visibility="{Binding Operations.IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Operations.ProgressValue, StringFormat={}{0:F0}%}"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Operations.IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleLogPanelCommand}"
                            Content="{Binding LogPanelButtonText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,2"
                            Margin="0,0,15,0"
                            Cursor="Hand"
                            FontSize="12"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Main Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <controls:WorkflowPanel/>
            </Border>
            
            <!-- Main Panel -->
            <Grid Grid.Column="1" x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{Binding ElementName=MainContentGrid, Path=DataContext.LogSplitterHeight, Mode=TwoWay}" MinHeight="0"/>
                    <RowDefinition Height="{Binding ElementName=MainContentGrid, Path=DataContext.LogPanelHeight, Mode=TwoWay}" MinHeight="0"/>
                </Grid.RowDefinitions>
                
                
                <!-- File Group Table with Tabs -->
                <TabControl Grid.Row="0" SelectedIndex="{Binding ActiveTabIndex}">
                    <TabItem Header="Line 1">
                        <controls:FileGroupDataGrid x:Name="Line1DataGrid" ItemsSource="{Binding Dashboard.Line1Groups}" LineNumber="1" />
                    </TabItem>
                    <TabItem Header="Line 2">
                        <controls:FileGroupDataGrid x:Name="Line2DataGrid" ItemsSource="{Binding Dashboard.Line2Groups}" LineNumber="2" />
                    </TabItem>
                    <TabItem Header="Combined">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Line 1 DataGrid -->
                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header -->
                                    <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                        <TextBlock Text="Line 1" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    
                                    <!-- DataGrid -->
                                    <controls:FileGroupDataGrid x:Name="CombinedLine1DataGrid" Grid.Row="1" ItemsSource="{Binding Dashboard.Line1Groups}" LineNumber="1" />
                                </Grid>
                            </Border>
                            
                            <!-- GridSplitter -->
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
                            
                            <!-- Line 2 DataGrid -->
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header -->
                                    <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                        <TextBlock Text="Line 2" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    
                                    <!-- DataGrid -->
                                    <controls:FileGroupDataGrid x:Name="CombinedLine2DataGrid" Grid.Row="1" ItemsSource="{Binding Dashboard.Line2Groups}" LineNumber="2" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
                
                <!-- GridSplitter for resizable log panel -->
                <GridSplitter Grid.Row="1" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              ShowsPreview="False"
                              ResizeDirection="Rows"
                              Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <!-- Message Log -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:LogPanel LogMessages="{Binding LogMessages}"
                                      CloseCommand="{Binding CloseLogPanelCommand}"
                                      ActiveTabIndex="{Binding ActiveTabIndex, Mode=OneWay}"/>
                </Border>
            </Grid>
        

    </Grid>
    </DockPanel>
</Window>

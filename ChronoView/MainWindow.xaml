<Window x:Class="ChronoView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChronoView"
        xmlns:vm="clr-namespace:ChronoView.UI.ViewModels"
        xmlns:controls="clr-namespace:ChronoView.UI.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:ChronoView.UI.Behaviors"
        mc:Ignorable="d"
        Title="ChronoView Pro - Desktop Application" 
        Height="900" Width="1400"
        Background="#f0f0f0"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Color Resources -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#f0f0f0"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#f5f5f5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#d0d0d0"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#0078d4"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#2d2d2d"/>
        
        <!-- Chip Style for Statistics -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#f5f5f5"/>
            <Setter Property="BorderBrush" Value="#d0d0d0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataGrid Style -->
        <Style x:Key="FileGroupDataGridStyle" TargetType="DataGrid">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#e0e0e0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="{Binding DataContext.DataGridRowHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=100}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        
        <!-- DataGrid Row Style for Abnormal Highlighting -->
        <Style x:Key="FileGroupRowStyle" TargetType="DataGridRow">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                    <Setter Property="Background" Value="#fff3cd"/>
                    <Setter Property="BorderBrush" Value="#ffc107"/>
                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" 
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Settings" Command="{Binding SetupCommand}"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}">
            <ToolBar Background="{StaticResource PanelBackgroundBrush}" 
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StartCommand}" ToolTip="Start monitoring">
                    <StackPanel>
                        <TextBlock Text="▶" FontSize="16"/>
                        <TextBlock Text="Start" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StopCommand}" ToolTip="Stop monitoring">
                    <StackPanel>
                        <TextBlock Text="■" FontSize="16"/>
                        <TextBlock Text="Stop" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Setup_Click" ToolTip="Open settings">
                    <StackPanel>
                        <TextBlock Text="⚙" FontSize="16"/>
                        <TextBlock Text="Setup" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="Refresh data">
                    <StackPanel>
                        <TextBlock Text="↻" FontSize="16"/>
                        <TextBlock Text="Refresh" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MoveCommand}" ToolTip="Move selected files">
                    <StackPanel>
                        <TextBlock Text="→" FontSize="16"/>
                        <TextBlock Text="Move" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Delete selected files">
                    <StackPanel>
                        <TextBlock Text="🗑" FontSize="16"/>
                        <TextBlock Text="Delete" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <!-- Date Input -->
                <Label Content="Date:" VerticalAlignment="Center"/>
                <TextBox Width="100" VerticalAlignment="Center" Text="{Binding DateInput}" ToolTip="YYYYMMDD format"/>
                <Button Content="Auto Config" Command="{Binding PathAutoConfigCommand}" Margin="4,0"/>
                <Separator/>
                <!-- Sample Folder -->
                <Label Content="Sample:" VerticalAlignment="Center"/>
                <TextBox Width="120" VerticalAlignment="Center" Text="{Binding SampleFolderName}" ToolTip="Sample folder name"/>
                <Button Content="Create Folder" Command="{Binding CreateSampleFolderCommand}" Margin="4,0"/>
            </ToolBar>
        </ToolBarTray>
        
        <!-- File Count Statistics Bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <TextBlock Text="📊 File Counts:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NIR1:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding NirCount}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Normal1:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cam1:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding Cam1Count}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cam2:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding Cam2Count}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cam3:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding Cam3Count}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
        
        <!-- Matching Statistics Bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <TextBlock Text="🔗 Matching Status:" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding TotalGroups}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="With NIR:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding WithNirCount}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Without NIR:" Foreground="#6c757d"/>
                        <TextBlock Text="{Binding WithoutNirCount}" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Failed:" Foreground="#dc2626"/>
                        <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Margin="5,0,0,0" Foreground="#dc2626"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Abnormal:" Foreground="#f59e0b"/>
                        <TextBlock Text="{Binding AbnormalCount}" FontWeight="Bold" Margin="5,0,0,0" Foreground="#f59e0b"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
        
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBackgroundBrush}" 
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            
            <StatusBarItem>
                <ProgressBar Value="{Binding ProgressValue}" 
                             Maximum="100" 
                             Height="12" 
                             Width="120" 
                             Margin="10,0"
                             Visibility="{Binding IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>

            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Groups: "/>
                    <TextBlock Text="{Binding TotalGroups}" FontWeight="Bold" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Match Rate: "/>
                    <TextBlock Text="{Binding MatchRate, StringFormat={}{0:F1}%}" FontWeight="Bold" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Failures: "/>
                    <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Foreground="Red" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NIR Connection: "/>
                    <TextBlock Text="{Binding NirConnectionStatus}" FontWeight="Bold" Foreground="Green" Margin="4,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Width="200">
                    <ProgressBar Width="150" Height="16"
                                 Value="{Binding ProgressValue}"
                                 Minimum="0" Maximum="100"
                                 Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss}}"/>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Main Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Workflow Control Section -->
                        <Expander Header="Workflow Control" IsExpanded="True" 
                                  Background="{StaticResource HoverBrush}" Margin="0,0,0,1">
                            <StackPanel Margin="10">
                                <TextBlock Text="System Status" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Main Cam:" Width="80"/>
                                    <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ready"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="NIR Cam:" Width="80"/>
                                    <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ready"/>
                                </StackPanel>
                                
                                <TextBlock Text="Sample Information" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Label Content="Sample Name:" FontSize="10"/>
                                <TextBox Text="{Binding SampleName}" Margin="0,0,0,8"/>
                                <Label Content="Move NIR:" FontSize="10"/>
                                <TextBox Text="{Binding MoveNir}" Margin="0,0,0,8"/>
                                <Label Content="Move All Data:" FontSize="10"/>
                                <TextBox Text="{Binding MoveAllData}"/>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Data Status Section -->
                        <Expander Header="Data Status" IsExpanded="True" 
                                  Background="{StaticResource HoverBrush}" Margin="0,0,0,1">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Total Groups:" Width="100"/>
                                    <TextBlock Text="{Binding TotalGroups}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Match Rate:" Width="100"/>
                                    <TextBlock Text="{Binding MatchRate, StringFormat={}{0:F1}%}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Failures:" Width="100"/>
                                    <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Foreground="Red"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Main Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="150" MinHeight="50"/>
                </Grid.RowDefinitions>
                
                <!-- File Group Table with Tabs -->
                <TabControl Grid.Row="0" SelectedIndex="{Binding ActiveTabIndex}">
                    <TabItem Header="Line 1">
                        <DataGrid ItemsSource="{Binding Line1Groups}"
                                  SelectionChanged="DataGrid_SelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource FileGroupDataGridStyle}"
                                  RowStyle="{StaticResource FileGroupRowStyle}">
                            <i:Interaction.Behaviors>
                                <behaviors:DragSelectBehavior/>
                            </i:Interaction.Behaviors>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Index" Width="80" Binding="{Binding GroupId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding StatusText}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Main Img" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding MainImageThumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding MainImageThumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NIR Graph" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}"
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}"
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding NirGraphThumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding NirGraphThumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 1" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera1Thumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding Camera1Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 2" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera2Thumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding Camera2Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 3" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera3Thumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding Camera3Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Line 2">
                        <DataGrid ItemsSource="{Binding Line2Groups}"
                                  SelectionChanged="DataGrid_SelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource FileGroupDataGridStyle}"
                                  RowStyle="{StaticResource FileGroupRowStyle}">
                            <i:Interaction.Behaviors>
                                <behaviors:DragSelectBehavior/>
                            </i:Interaction.Behaviors>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Index" Width="80" Binding="{Binding GroupId}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding StatusText}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Main Img" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding MainImageThumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding MainImageThumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NIR Graph" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}"
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}"
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding NirGraphThumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding NirGraphThumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 4" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera4Thumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding Camera4Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 5" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera5Thumbnail}" Stretch="Uniform"/>
                                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom"
                                                                 Visibility="{Binding Camera5Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cam 6" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.DisplayImageWidth, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=120}" 
                                                    Height="{Binding DataContext.DisplayImageHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=90}" 
                                                    Background="#3a3a3a" BorderBrush="#505050" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Camera6Thumbnail}" Stretch="Uniform"/>

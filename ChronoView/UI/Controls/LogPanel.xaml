<UserControl x:Class="ChronoView.UI.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:ChronoView.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- Style for log severity colors -->
        <Style x:Key="LogRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="#dc2626"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="#f59e0b"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="Foreground" Value="#3b82f6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <DockPanel>
        <!-- Header with Controls -->
        <Border DockPanel.Dock="Top" Background="#f5f5f5" 
                BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Log_MessageLog}" FontWeight="Bold" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.Log_Search}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="SearchBox" Width="200" 
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="{x:Static res:Strings.Tooltip_SearchLog}"/>
                    
                    <TextBlock Text="{x:Static res:Strings.Log_Level}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="LevelFilter" Width="100"
                              SelectionChanged="LevelFilter_SelectionChanged"
                              ToolTip="{x:Static res:Strings.Tooltip_FilterLevel}">
                        <ComboBoxItem Content="{x:Static res:Strings.Status_All}" Tag="{x:Null}"/>
                        <ComboBoxItem Content="{x:Static res:Strings.Status_Debug}" Tag="Debug"/>
                        <ComboBoxItem Content="{x:Static res:Strings.Status_Info}" IsSelected="True" Tag="Info"/>
                        <ComboBoxItem Content="{x:Static res:Strings.Status_Warning}" Tag="Warning"/>
                        <ComboBoxItem Content="{x:Static res:Strings.Status_Error}" Tag="Error"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="AutoScrollCheckBox" 
                              Content="{x:Static res:Strings.Log_AutoScroll}" 
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Log_Clear}" Click="Clear_Click" Padding="8,4" Margin="4,0"/>
                    <Button Content="로그 저장" 
                            Click="QuickSave_Click" 
                            ToolTip="현재 필터된 로그를 기본 경로에 저장합니다"
                            Padding="8,4" Margin="4,0"/>
                    <Button Content="📁" 
                            Click="OpenLogFolder_Click"
                            ToolTip="로그 파일이 저장된 폴더를 엽니다"
                            Width="30" Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="4,0,0,0"/>
                    <Button Content="✕" 
                            Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="30" 
                            Height="30" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            FontSize="16" 
                            Cursor="Hand"
                            Padding="0"
                            Margin="8,0,0,0"
                            ToolTip="로그 패널 닫기"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Log DataGrid -->
        <DataGrid x:Name="LogDataGrid"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  HeadersVisibility="Column" 
                  GridLinesVisibility="Horizontal"
                  RowStyle="{StaticResource LogRowStyle}"
                  SelectionMode="Extended"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Strings.Log_Severity}" Width="80" Binding="{Binding Severity}"/>
                <DataGridTextColumn Header="{x:Static res:Strings.Log_Time}" Width="100" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"/>
                <DataGridTextColumn Header="{x:Static res:Strings.Log_Source}" Width="120" Binding="{Binding Source}"/>
                <DataGridTextColumn Header="{x:Static res:Strings.Log_Message}" Width="*" Binding="{Binding Message}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="ChronoView.UI.Controls.FileGroupDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChronoView.UI.Controls"
             xmlns:behaviors="clr-namespace:ChronoView.UI.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:res="clr-namespace:ChronoView.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <!-- Local copy of SelectAll logic if needed, but we handle it in code-behind -->
    </UserControl.Resources>

    <DataGrid x:Name="MainDataGrid"
              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              Style="{StaticResource FileGroupDataGridStyle}"
              RowStyle="{StaticResource FileGroupRowStyle}"
              RowHeight="{Binding DataContext.DataGridRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
              SelectionChanged="DataGrid_SelectionChanged">
        
        <i:Interaction.Behaviors>
            <behaviors:DragSelectBehavior/>
        </i:Interaction.Behaviors>

        <DataGrid.InputBindings>
             <!-- Bind Double Click to OpenDetailViewCommand on the ViewModel -->
             <!-- Note: Ancestor Binding is tricky depending on where the Command lives. 
                  If MainViewModel is the DataContext of the Window, and this UserControl inherits it... 
                  we verify logic later. -->
             <MouseBinding Gesture="LeftDoubleClick" 
                           Command="{Binding DataContext.OpenDetailViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding ElementName=MainDataGrid, Path=SelectedItem}"/>
        </DataGrid.InputBindings>

        <DataGrid.Columns>
            <!-- Checkbox Column (Static) -->
            <DataGridTemplateColumn Width="40">
                <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="SelectAllCheckBox"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Checked="SelectAllCheckBox_Checked"
                                  Unchecked="SelectAllCheckBox_Unchecked"/>
                    </DataTemplate>
                </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Index Column (Static) -->
            <DataGridTextColumn Header="{x:Static res:Strings.Column_Index}" Width="80" Binding="{Binding GroupId}" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Status Column (Static) -->
            <DataGridTextColumn Header="{x:Static res:Strings.Column_Status}" Width="100" Binding="{Binding StatusText}" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Dynamic Columns will be added here by code-behind -->
        </DataGrid.Columns>
    </DataGrid>
</UserControl>

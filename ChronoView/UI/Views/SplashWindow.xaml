<Window x:Class="ChronoView.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChronoView Pro"
        Height="450" Width="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Background="#D41C24" CornerRadius="10">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- PRISCHE Logo Box -->
                <Border BorderBrush="White"
                        BorderThickness="4"
                        Padding="40,20"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,40">
                    <TextBlock Text="PRISCHE"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="60"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Main Title -->
                <TextBlock Text="ChronoView Pro"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="32"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Subtitle -->
                <TextBlock Text="Professional Monitoring Application"
                           FontFamily="Segoe UI"
                           FontWeight="Light"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Opacity="0.9"/>

                <!-- Loading Indicator (optional) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0">
                    <TextBlock Text="Loading"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.8"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="LoadingDots"
                               Text="..."
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.8"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>

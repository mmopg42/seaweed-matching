<Window x:Class="ChronoView.UI.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Preview" 
        SizeToContent="WidthAndHeight"
        MinWidth="400" MinHeight="300"
        MaxWidth="1200" MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="#444444" BorderThickness="2">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Close button -->
        <Border Background="#2D2D2D" Padding="10" MouseLeftButtonDown="Header_MouseDown">
            <DockPanel>
                <TextBlock Text="{Binding ImageTitle}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="40" Height="30" 
                        Background="Transparent" Foreground="White" BorderThickness="0" 
                        FontSize="18" Cursor="Hand" Click="Close_Click"/>
            </DockPanel>
        </Border>

        <!-- Image Content -->
        <Grid Grid.Row="1" Margin="10" Background="Transparent">
            <Image Source="{Binding DisplayImage}" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Cursor="Hand"
                   MouseDown="Window_MouseDown">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                </Image.Effect>
            </Image>
        </Grid>
        
        <TextBlock Text="Click image to close" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                   Margin="10" Foreground="#88FFFFFF" FontSize="12" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>

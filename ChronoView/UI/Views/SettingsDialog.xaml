<Window x:Class="ChronoView.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChronoView.UI.ViewModels"
        xmlns:res="clr-namespace:ChronoView.Resources"
        Title="{x:Static res:Strings.Dialog_Settings}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#f0f0f0">
    
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <DockPanel>
        <!-- Button Panel -->
        <Border DockPanel.Dock="Bottom" Background="#f5f5f5" BorderBrush="#d0d0d0" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Button_Apply}" Width="80" Height="30" Margin="0,0,10,0" Command="{Binding ApplyCommand}"/>
                <Button Content="{x:Static res:Strings.Button_OK}" Width="80" Height="30" Margin="0,0,10,0" Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="{x:Static res:Strings.Button_Cancel}" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <TabControl Margin="10">
            <!-- Paths Tab -->
            <TabItem Header="{x:Static res:Strings.Tab_Paths}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Line 1 Paths -->
                        <TextBlock Text="{x:Static res:Strings.Section_Line1Paths}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Nir1Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir1"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Normal1Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NormalPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="normal1"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="normal1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera1Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera1Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam1"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera2Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam2"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera3Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera3Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam3"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam3" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Line 2 Paths -->
                        <TextBlock Text="{x:Static res:Strings.Section_Line2Paths}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Nir2Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir2"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Normal2Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Normal2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="normal2"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="normal2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera4Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera4Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam4"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam4" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera5Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera5Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam5"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam5" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_Camera6Path}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera6Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam6"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam6" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Output Path -->
                        <TextBlock Text="{x:Static res:Strings.Section_Output}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_OutputPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding OutputPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="output"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="output" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Quarantine Path -->
                        <TextBlock Text="{x:Static res:Strings.Section_Quarantine}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_QuarantinePath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DeleteQuarantinePath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="quarantine"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="quarantine" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Advanced Tab -->
            <TabItem Header="{x:Static res:Strings.Tab_Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{x:Static res:Strings.Section_CameraSubfolderOptions}" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_UseCameraSubfolderNormal}" IsChecked="{Binding UseCameraSubfolderNormal}" Margin="0,5"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_UseCameraSubfolderNormal2}" IsChecked="{Binding UseCameraSubfolderNormal2}" Margin="0,5"/>
                        
                        <TextBlock Text="{x:Static res:Strings.Section_ImageProcessing}" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_EnableDiskCache}" IsChecked="{Binding UseDiskCache}" Margin="0,5"/>
                        
                        <TextBlock Text="{x:Static res:Strings.Section_UIOptions}" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_LegacyUiMode}" IsChecked="{Binding LegacyUiMode}" Margin="0,5"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_UseFolderSuffix}" IsChecked="{Binding UseFolderSuffix}" Margin="0,5"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_ShowTooltips}" IsChecked="{Binding ShowTooltips}" Margin="0,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- UI Options Tab -->
            <TabItem Header="{x:Static res:Strings.Tab_UIOptions}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{x:Static res:Strings.Section_ImageDisplaySize}" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_ImageWidth}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DisplayImageWidth}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Default_120}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_ImageHeight}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DisplayImageHeight}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Default_90}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_NirDisplayWidth}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirDisplayWidth}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Default_120}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_NirDisplayHeight}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirDisplayHeight}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Default_90}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_RowHeight}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DataGridRowHeight}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Default_100}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="{x:Static res:Strings.Section_NirGraphOptions}" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_EnableNirGraph}" IsChecked="{Binding EnableNirGraph}" Margin="0,5"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_GraphGenWidth}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirThumbnailWidth}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Helper_ImageGenerationSize}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_GraphGenHeight}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirThumbnailHeight}" Width="100"/>
                            <TextBlock Text="{x:Static res:Strings.Helper_ImageGenerationSize}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="{x:Static res:Strings.Section_UIDisplayOptions}" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_LegacyUiMode}" IsChecked="{Binding LegacyUiMode}" Margin="0,5"/>
                        <CheckBox Content="{x:Static res:Strings.Checkbox_ShowTooltips}" IsChecked="{Binding ShowTooltips}" Margin="0,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Data Sequence Tab -->
            <TabItem Header="{x:Static res:Strings.Tab_DataSequence}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{x:Static res:Strings.Section_DataArrivalSequence}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{x:Static res:Strings.Helper_DataSequenceDescription}" 
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>
                        
                        
                        <!-- Sequence List -->
                        <TextBlock Text="{x:Static res:Strings.Label_DataSequence}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border BorderBrush="#d0d0d0" BorderThickness="1" Padding="5" Background="White">
                            <ListBox x:Name="SequenceListBox" 
                                     ItemsSource="{Binding SequenceItems}" 
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="SequenceListBox_PreviewMouseDown"
                                     MouseMove="SequenceListBox_MouseMove"
                                     DragOver="SequenceListBox_DragOver"
                                     Drop="SequenceListBox_Drop"
                                     MinHeight="300"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Drag Handle -->
                                                <TextBlock Grid.Column="0" Text="≡" FontSize="18" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Gray" Cursor="Hand"/>
                                                
                                                <!-- Type Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                           VerticalAlignment="Center" FontWeight="Bold"/>
                                                
                                                <!-- Min Delay -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Static res:Strings.Label_Min}" Foreground="Gray"/>
                                                    <TextBox Text="{Binding MinDelay}" Width="40"
                                                             VerticalAlignment="Center" Padding="2"/>
                                                    <TextBlock Text="{x:Static res:Strings.Label_Seconds}" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                                                </StackPanel>
                                                
                                                <!-- Max Delay -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Static res:Strings.Label_Max}" Foreground="Gray"/>
                                                    <TextBox Text="{Binding MaxDelay}" Width="40"
                                                             VerticalAlignment="Center" Padding="2"/>
                                                    <TextBlock Text="{x:Static res:Strings.Label_Seconds}" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                                                </StackPanel>
                                                
                                                <!-- Enabled Checkbox -->
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" 
                                                          Content="{x:Static res:Strings.Checkbox_Enabled}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                                <!-- ListBoxItem Style for Drop Target Highlighting -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Background" Value="#e0e0e0"/>
                                                <Setter Property="BorderBrush" Value="#0078d4"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                        
                        <!-- Help Text -->
                        <TextBlock TextWrapping="Wrap" Margin="0,10" Foreground="Gray" FontStyle="Italic">
                            <Run Text="{x:Static res:Strings.Help_DragToReorder}"/>
                            <LineBreak/>
                            <Run Text="{x:Static res:Strings.Help_MinDelay}"/>
                            <LineBreak/>
                            <Run Text="{x:Static res:Strings.Help_MaxDelay}"/>
                            <LineBreak/>
                            <Run Text="{x:Static res:Strings.Help_UncheckedItems}"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- External Programs Tab -->
            <TabItem Header="{x:Static res:Strings.Tab_ExternalPrograms}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{x:Static res:Strings.Section_ExternalProgramConfig}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{x:Static res:Strings.Helper_ExternalProgramDescription}" 
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>
                        
                        <!-- General Camera Program -->
                        <TextBlock Text="{x:Static res:Strings.Section_GeneralCameraProgram}" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_ProgramPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding GeneralCameraProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="generalcamera"/>
                        </StackPanel>
                        
                        <!-- NIR Program 1 -->
                        <TextBlock Text="{x:Static res:Strings.Section_NirProgram1}" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_ProgramPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir1ProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="nir1program"/>
                        </StackPanel>
                        
                        <!-- NIR Program 2 -->
                        <TextBlock Text="{x:Static res:Strings.Section_NirProgram2}" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_ProgramPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2ProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="nir2program"/>
                        </StackPanel>
                        
                        <!-- NIR2 Filtering Paths -->
                        <TextBlock Text="{x:Static res:Strings.Section_Nir2FilteringConfig}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{x:Static res:Strings.Helper_Nir2FilteringDescription}" 
                                   TextWrapping="Wrap" Margin="0,0,0,5" Foreground="Gray" FontSize="11"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_MonitorPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2FilterMonitorPath}" Width="400" Margin="0,0,5,0" 
                                     ToolTip="{x:Static res:Strings.Tooltip_MonitorPath}"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir2filtermonitor"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir2filtermonitor" ToolTip="{x:Static res:Strings.Tooltip_OpenFolderInExplorer}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="{x:Static res:Strings.Label_DestinationPath}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2FilterDestinationPath}" Width="400" Margin="0,0,5,0"
                                     ToolTip="{x:Static res:Strings.Tooltip_DestinationPath}"/>
                            <Button Content="{x:Static res:Strings.Button_Browse}" Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir2filterdest"/>
                            <Button Content="{x:Static res:Strings.Button_Open}" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir2filterdest" ToolTip="{x:Static res:Strings.Tooltip_OpenFolderInExplorer}"/>
                        </StackPanel>
                        
                        <!-- Help Text -->
                        <TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Foreground="Gray" FontStyle="Italic">
                            <Run Text="{x:Static res:Strings.Help_ExternalProgramsLaunch}"/>
                            <LineBreak/>
                            <Run Text="{x:Static res:Strings.Help_OnlyExeSupported}"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

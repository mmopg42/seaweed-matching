<Window x:Class="ChronoView.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChronoView.UI.ViewModels"
        Title="Settings" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#f0f0f0">
    
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <DockPanel>
        <!-- Button Panel -->
        <Border DockPanel.Dock="Bottom" Background="#f5f5f5" BorderBrush="#d0d0d0" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="80" Height="30" Margin="0,0,10,0" Command="{Binding ApplyCommand}"/>
                <Button Content="OK" Width="80" Height="30" Margin="0,0,10,0" Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="Cancel" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <TabControl Margin="10">
            <!-- Paths Tab -->
            <TabItem Header="Paths">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Line 1 Paths -->
                        <TextBlock Text="Line 1 Paths" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="NIR 1 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir1"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Normal 1 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NormalPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="normal1"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="normal1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 1 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera1Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam1"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam1" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 2 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam2"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 3 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera3Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam3"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam3" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Line 2 Paths -->
                        <TextBlock Text="Line 2 Paths" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="NIR 2 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="nir2"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="nir2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Normal 2 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Normal2Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="normal2"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="normal2" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 4 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera4Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam4"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam4" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 5 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera5Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam5"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam5" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Camera 6 Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Camera6Path}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="cam6"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="cam6" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Output Path -->
                        <TextBlock Text="Output" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Output Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding OutputPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="output"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="output" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                        
                        <!-- Quarantine Path -->
                        <TextBlock Text="Quarantine (Trash)" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Quarantine Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DeleteQuarantinePath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Margin="0,0,5,0" Command="{Binding BrowsePathCommand}" CommandParameter="quarantine"/>
                            <Button Content="📁 Open" Width="80" Command="{Binding OpenFolderCommand}" CommandParameter="quarantine" ToolTip="Open folder in Explorer"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Advanced Tab -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Camera Subfolder Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Use camera subfolder for Normal1" IsChecked="{Binding UseCameraSubfolderNormal}" Margin="0,5"/>
                        <CheckBox Content="Use camera subfolder for Normal2" IsChecked="{Binding UseCameraSubfolderNormal2}" Margin="0,5"/>
                        
                        <TextBlock Text="Image Processing" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Enable disk cache for thumbnails" IsChecked="{Binding UseDiskCache}" Margin="0,5"/>
                        
                        <TextBlock Text="UI Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Legacy UI mode" IsChecked="{Binding LegacyUiMode}" Margin="0,5"/>
                        <CheckBox Content="Use folder suffix" IsChecked="{Binding UseFolderSuffix}" Margin="0,5"/>
                        <CheckBox Content="Show tooltips" IsChecked="{Binding ShowTooltips}" Margin="0,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- UI Options Tab -->
            <TabItem Header="UI Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Image Display Size" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Image Width (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DisplayImageWidth}" Width="100"/>
                            <TextBlock Text="(Default: 120)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Image Height (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DisplayImageHeight}" Width="100"/>
                            <TextBlock Text="(Default: 90)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="NIR Display Width (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirDisplayWidth}" Width="100"/>
                            <TextBlock Text="(Default: 120)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="NIR Display Height (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirDisplayHeight}" Width="100"/>
                            <TextBlock Text="(Default: 90)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Row Height (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DataGridRowHeight}" Width="100"/>
                            <TextBlock Text="(Default: 100)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="NIR Graph Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Enable NIR Graph" IsChecked="{Binding EnableNirGraph}" Margin="0,5"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Graph Gen Width (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirThumbnailWidth}" Width="100"/>
                            <TextBlock Text="(Image Generation Size)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Graph Gen Height (px):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NirThumbnailHeight}" Width="100"/>
                            <TextBlock Text="(Image Generation Size)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="UI Display Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Legacy UI mode" IsChecked="{Binding LegacyUiMode}" Margin="0,5"/>
                        <CheckBox Content="Show tooltips" IsChecked="{Binding ShowTooltips}" Margin="0,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Data Sequence Tab -->
            <TabItem Header="Data Sequence">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Data Arrival Sequence Configuration" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure the expected order of data arrival and matching tolerances." 
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>
                        
                        
                        <!-- Sequence List -->
                        <TextBlock Text="Data Sequence (Drag to reorder):" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border BorderBrush="#d0d0d0" BorderThickness="1" Padding="5" Background="White">
                            <ListBox x:Name="SequenceListBox" 
                                     ItemsSource="{Binding SequenceItems}" 
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="SequenceListBox_PreviewMouseDown"
                                     MouseMove="SequenceListBox_MouseMove"
                                     DragOver="SequenceListBox_DragOver"
                                     Drop="SequenceListBox_Drop"
                                     MinHeight="300"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Drag Handle -->
                                                <TextBlock Grid.Column="0" Text="≡" FontSize="18" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Gray" Cursor="Hand"/>
                                                
                                                <!-- Type Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                           VerticalAlignment="Center" FontWeight="Bold"/>
                                                
                                                <!-- Min Delay -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Min: " Foreground="Gray"/>
                                                    <TextBox Text="{Binding MinDelay}" Width="40"
                                                             VerticalAlignment="Center" Padding="2"/>
                                                    <TextBlock Text="s" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                                                </StackPanel>
                                                
                                                <!-- Max Delay -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Max: " Foreground="Gray"/>
                                                    <TextBox Text="{Binding MaxDelay}" Width="40"
                                                             VerticalAlignment="Center" Padding="2"/>
                                                    <TextBlock Text="s" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                                                </StackPanel>
                                                
                                                <!-- Enabled Checkbox -->
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" 
                                                          Content="Enabled" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                                <!-- ListBoxItem Style for Drop Target Highlighting -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Background" Value="#e0e0e0"/>
                                                <Setter Property="BorderBrush" Value="#0078d4"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                        
                        <!-- Help Text -->
                        <TextBlock TextWrapping="Wrap" Margin="0,10" Foreground="Gray" FontStyle="Italic">
                            <Run Text="• Drag ≡ to reorder items"/>
                            <LineBreak/>
                            <Run Text="• 'Min' is the minimum time (seconds) after the previous data type"/>
                            <LineBreak/>
                            <Run Text="• 'Max' is the maximum time (seconds) after the previous data type"/>
                            <LineBreak/>
                            <Run Text="• Unchecked items will be hidden from the UI"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- External Programs Tab -->
            <TabItem Header="External Programs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="External Program Configuration" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure paths to external programs launched from Setup window." 
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>
                        
                        <!-- General Camera Program -->
                        <TextBlock Text="General Camera Program" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Program Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding GeneralCameraProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="generalcamera"/>
                        </StackPanel>
                        
                        <!-- NIR Program 1 -->
                        <TextBlock Text="NIR Program 1" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Program Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir1ProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="nir1program"/>
                        </StackPanel>
                        
                        <!-- NIR Program 2 -->
                        <TextBlock Text="NIR Program 2" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Label Content="Program Path:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Nir2ProgramPath}" Width="400" Margin="0,0,5,0"/>
                            <Button Content="Browse..." Width="80" Command="{Binding BrowseExeCommand}" CommandParameter="nir2program"/>
                        </StackPanel>
                        
                        <!-- Help Text -->
                        <TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Foreground="Gray" FontStyle="Italic">
                            <Run Text="• These programs will be launched when clicking the corresponding buttons in the Setup window"/>
                            <LineBreak/>
                            <Run Text="• Only .exe files are supported"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

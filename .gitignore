# ===========================
# 1. 기본 정책: 모든 파일 무시
# ===========================
*

# ===========================
# 2. 디렉토리 허용 (재귀적 탐색을 위해)
# ===========================
!*/
!**/

# ===========================
# 3. 소스 코드 및 리소스 허용 (Whitelist)
# ===========================

# 문서
!.gitignore
!README.md
!docs/**/*.txt
!*.md

# C# (.NET)
!*.sln
!*.csproj
!*.cs
!*.xaml
!*.config
!*.json
!*.resx
!*.settings

# Python
!*.py
!requirements.txt

# Web / Config / 기타
!*.xml
!*.html
!*.css
!*.js
!*.ico
!*.png
!*.jpg
!*.bmp

# 에이전트 및 프로젝트 설정
!.kiro/
!.agent/
!.claude/
!.cursor/

# ===========================
# 4. 빌드 결과물 및 정크 파일 재무시 (Blacklist override)
# ===========================

# .NET 빌드
**/bin/
**/obj/
**/packages/
.nuget/

# Python 빌드/캐시
**/__pycache__/
*.pyc
*.pyo
*.pyd

# 일반적인 빌드 폴더
**/build/
**/dist/

# IDE / 에디터 설정
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# 로그 및 임시 파일
*.log
*.tmp
*.bak
*.swp
build_errors.txt
error.txt
error2.txt
build_output.txt

# 테스트 결과 파일들
*_result.txt
output.txt

# Auto Claude data directory
.auto-claude/
